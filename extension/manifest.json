{
  "manifest_version": 3,
  "name": "Yahoo Classique",
  "version": "1.0.0",
  "author": "athor",
  "description": "Un habillage classique violet pour la nouvelle interface Yahoo Mail.",
  "homepage_url": "https://github.com/athor",
  "permissions": ["storage"],
  "action": {
    "default_title": "Yahoo Classique",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "content_scripts": [{
    "matches": ["https://mail.yahoo.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["classic.css"],
    "matches": ["https://mail.yahoo.com/*"]
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "yahoo-classique@athor.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
